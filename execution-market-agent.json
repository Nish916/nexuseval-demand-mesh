    "content_generation",
    "code_execution",
    "api_integration",
    "web_research",
    "bounty_qualification",
    "qa_evaluation",
    "delivery_validation",
    "payment_evidence_verification"
  ],
  "guardrails": [
    "zero_upfront_spend",
    "no_self_funding_or_synthetic_demand",
    "no_gambling_or_speculative_trading",
    "authorized_security_scope_only",
    "no_spam_or_deceptive_promotion",
    "no_new_legal_kyc_contract_acceptance_without_owner_approval",
    "settlement_evidence_required_for_revenue"
